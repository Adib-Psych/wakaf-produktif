 function authority(p,g){
 return request.auth != null && p.keys().hasOnly(['paused','writer_epoch']) && p.paused is bool && p.paused == false && p.writer_epoch is int && p.writer_epoch>0 && g.keys().size()==6 && g.keys().hasOnly(['uid','enabled','role','worker_token','writer_epoch','grant_epoch']) && g.grant_epoch is int && g.grant_epoch>0 && g.worker_token is string && g.uid == request.auth.uid && g.enabled == true && g.writer_epoch == p.writer_epoch && g.role in ['staff','worker'];
 }
 function live(){return request.auth!=null && authority(policy(),grant());}
