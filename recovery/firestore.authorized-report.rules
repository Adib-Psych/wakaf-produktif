 function staff20(d){return d is map && d.keys().hasOnly(["_kategoriTitle","Stakeholder","Channel","Topik Utama","Status Hasil","Detail Pembicaraan"]) && (!('_kategoriTitle' in d)||d._kategoriTitle=="☎️Komunikasi Stakeholder (Audit Trail Amanah)") && (!("Stakeholder" in d)||(d["Stakeholder"] in ["Bonsari Coffee (specialty offtaker)","Nomad Coffee (specialty offtaker)","BRIN Purwodadi (rujukan agronomi)","Ust. Fauzan (pengawas syariah + TPQ Darul Mujtaba)","TPQ Darul Mujtaba (mauquf alaih)","MWC NU (panen pisang)","UB Brawijaya (lab + magang)","Lab UB Soil Test","Gapoktan Ngantang (Kartu Tani)","Penjajakan kemitraan strategis baru","Lainnya"])) && (!("Channel" in d)||(d["Channel"] in ["kunjungan_langsung","WhatsApp/chat","telepon","email","meeting_formal"])) && (!("Topik Utama" in d)||(d["Topik Utama"] is string)) && (!("Status Hasil" in d)||(d["Status Hasil"] in ["resolved_kesepakatan","pending_followup","perlu_eskalasi_wakif","info_only"])) && (!("Detail Pembicaraan" in d)||(d["Detail Pembicaraan"] is string));}
 function staff21(d){return d is map && d.keys().hasOnly(["_kategoriTitle"]) && (!('_kategoriTitle' in d)||d._kategoriTitle=="📝 Detail Aktivitas Lain");}
 function staffDetail(category,d){return d==null || (category=="pemupukan_organik"?staff0(d):(category=="pemupukan_kimia"?staff1(d):(category=="pemangkasan"?staff2(d):(category=="babat_rumput"?staff3(d):(category=="penyemprotan"?staff4(d):(category=="panen"?staff5(d):(category=="sortasi_buah"?staff6(d):(category=="penjemuran"?staff7(d):(category=="build_rorak"?staff8(d):(category=="kompos_kulit_kopi"?staff9(d):(category=="tanam_penaung"?staff10(d):(category=="inventarisasi_pohon"?staff11(d):(category=="opt_monitoring"?staff12(d):(category=="brocap_management"?staff13(d):(category=="soil_test"?staff14(d):(category=="topgraft_robusta"?staff15(d):(category=="bokashi_production"?staff16(d):(category=="arachis_management"?staff17(d):(category=="biochar_pyrolysis"?staff18(d):(category=="pisang_management"?staff19(d):(category=="komunikasi_stakeholder"?staff20(d):(category=="lain"?staff21(d):false))))))))))))))))))))));}
// END STAFF DOM CONTRACT
 function body(b,g){return b is map && b.id is string && b.id.matches('^lap_[A-Za-z0-9_-]{1,96}$') && b.kategori in ["pemupukan_kimia","pemupukan_organik","pemangkasan","panen","penyemprotan","build_rorak","pisang_management","inventarisasi_pohon","tanam_penaung","kompos_kulit_kopi","babat_rumput","sortasi_buah","penjemuran","opt_monitoring","brocap_management","topgraft_robusta","soil_test","bokashi_production","komunikasi_stakeholder","arachis_management","biochar_pyrolysis","lain"] && b.created_at is string && calendar(b.tanggal)
  && (g.role == 'staff' ? ( b.schema_version == '3.5' && b.src in ['wakif_form','wakif_form_multi'] && b.tgl==b.tanggal && b.pelapor is string && b.bidang is string && b.kebun_list is list && b.kebun_list.hasOnly(['K1','K2','K3','K4']) && (b.kebun_primary==null || b.kebun_primary is string) && b.kebun_list_str is string && b.pohon is number && b.pohon>=0 && b.detail is string && (b.durasi==null || b.durasi is string) && staffDetail(b.kategori,b.detail_form) && b.rainfall_24h is number && b.rainfall_24h>=0 && b.rainfall_7d is number && b.rainfall_7d>=0 && b.compliance is string && b.alerts is list && b.keys().size()==20
    && b.keys().toSet()==['id','tgl','pelapor','bidang','kategori','kebun_list','kebun_primary','kebun_list_str','pohon','detail','durasi','detail_form','rainfall_24h','rainfall_7d','compliance','alerts','created_at','tanggal','schema_version','src'].toSet())
   : (g.role == 'worker' && categoryDetail(b.kategori,b.detail) && b.schema_version == '1.1' && b.pelapor == g.worker_token && b.pelapor_name is string && b.compliance is string && b.kebun is list && b.kebun.hasOnly(['K1','K2','K3','K4']) && (b.kebun_primary==null || b.kebun_primary is string) && b.kebun_list_str is string && (b.blok==null || b.blok is string) && (b.cuaca_pagi==null || b.cuaca_pagi is string) && (b.cuaca_siang==null || b.cuaca_siang is string) && (b.rain_24h_mm==null || (b.rain_24h_mm is number && b.rain_24h_mm>=0)) && (b.rain_7d_mm==null || (b.rain_7d_mm is number && b.rain_7d_mm>=0)) && b.weather_source is string && b.weather_coords is string && b.weather_lokasi is string && (b.topik_v2==null || b.topik_v2 is string) && (b.durasi==null || b.durasi is string) && b.jumlah_pekerja is int && b.jumlah_pekerja>0 && b.jumlah_pohon is int && b.jumlah_pohon>=0 && b.detail is map && (b.catatan==null || b.catatan is string) && (b.gps_coords==null || b.gps_coords is string) && (b.gps_jarak_km==null || b.gps_jarak_km is number) && (b.gps_di_kebun==null || b.gps_di_kebun is bool) && b.device_id is string && b._filled_by is map && b.keys().size()==32
    && b.keys().toSet()==['id','created_at','compliance','schema_version','pelapor','pelapor_name','tanggal','kebun','kebun_primary','kebun_list_str','blok','cuaca_pagi','cuaca_siang','rain_24h_mm','rain_7d_mm','weather_source','weather_coords','weather_lokasi','kategori','topik_v2','durasi','jumlah_pekerja','jumlah_pohon','detail','catatan','voice_notes','photos','gps_coords','gps_jarak_km','gps_di_kebun','device_id','_filled_by'].toSet()));}
 function valid(d,rid){let g=grant();let p=policy();return request.auth!=null && authority(p,g) && d.keys().toSet()==['contract_version','report_id','command_id','writer_epoch','grant_epoch','submitted_body','owner_uid','committed_revision','committed_at'].toSet() && d.keys().size()==9 && d.contract_version is int && d.contract_version==1 && d.writer_epoch is int && d.grant_epoch is int && d.committed_revision is int && d.report_id==rid && d.command_id==rid && d.owner_uid==request.auth.uid && d.writer_epoch==p.writer_epoch && d.grant_epoch==g.grant_epoch && d.committed_revision==1 && d.committed_at==request.time && d.submitted_body.id==rid ;}
 function pairedMedia(b){return grant().role!='worker' || (voices(b.voice_notes) && photos(b.photos));}
 match /entry_policy/active {allow get: if request.auth!=null;allow write,list:if false;}
 match /entry_grants/{uid}{allow get:if request.auth!=null && request.auth.uid==uid;allow write,list:if false;}
 match /laporan/{rid}{
  allow get:if live() && (!exists(/databases/$(database)/documents/laporan/$(rid)) || grant().role=='staff' || resource.data.owner_uid==request.auth.uid);
  allow list:if live() && grant().role=='staff';
  allow create:if body(request.resource.data.submitted_body,grant()) && valid(request.resource.data,rid) && !exists(/databases/$(database)/documents/entry_receipts/$(rid)) && getAfter(/databases/$(database)/documents/entry_receipts/$(rid)).data==request.resource.data;
  allow update,delete:if false;
 }
 match /entry_receipts/{rid}{
  allow get:if live() && (!exists(/databases/$(database)/documents/entry_receipts/$(rid)) || grant().role=='staff' || resource.data.owner_uid==request.auth.uid);
  allow create:if request.auth!=null && !exists(/databases/$(database)/documents/laporan/$(rid)) && getAfter(/databases/$(database)/documents/laporan/$(rid)).data==request.resource.data && pairedMedia(request.resource.data.submitted_body);
  allow list,update,delete:if false;
 }

 // Staging only; operation_policy is server-controlled and absent-by-default.
 function opEnabled(kind){return get(/databases/$(database)/documents/operation_policy/$(kind)).data.enabled==true;}
 function headPath(o){return o.kind!='correction' ? /databases/$(database)/documents/cabut_state/$(o.target) : /databases/$(database)/documents/report_heads/$(o.target);}
 function pendingWork(b){let labels={'tali_merah':'hanya pohon bertali merah','akar_keluar':'dicabut sampai akar','lubang_ditutup':'lubang ditutup tanah','kayu_dibawa_keluar':'kayu & akar dibawa keluar kebun'};return b.pending.size()==b.pending.toSet().size() && ('tali_merah' in b.pending)==!b.checklist.tali_merah && ('akar_keluar' in b.pending)==!b.checklist.akar_keluar && ('lubang_ditutup' in b.pending)==!b.checklist.lubang_ditutup && ('kayu_dibawa_keluar' in b.pending)==!b.checklist.kayu_dibawa_keluar && b.pending_label.size()==b.pending.size() && (b.pending.size()<1||b.pending_label[0]==labels[b.pending[0]]) && (b.pending.size()<2||b.pending_label[1]==labels[b.pending[1]]) && (b.pending.size()<3||b.pending_label[2]==labels[b.pending[2]]) && (b.pending.size()<4||b.pending_label[3]==labels[b.pending[3]]);}
 function cabutBody(b){return b is map && b.keys().hasOnly(['id','pelapor','kategori','tanggal','tgl','kebun','kebun_primary','kebun_list_str','jumlah_pohon','pekerja_nama','lokasi','metode','tali','checklist','pending','pending_label','gps','photos','status_verifikasi','created_at','schema_version','src']) && b.keys().size()==22 && b.pelapor=='BORONGAN' && b.kategori=='cabut_borongan' && b.tgl==b.tanggal && b.kebun_primary==b.kebun && b.kebun_list_str==b.kebun && b.metode=='cabut' && b.tali=='merah' && b.status_verifikasi=='menunggu' && b.created_at is string && b.schema_version=='cabut-borongan-1.4' && b.src=='lapor_cabut_v4' && b.photos is list && b.photos.size()==0 && b.pending is list && b.pending.hasOnly(['tali_merah','akar_keluar','lubang_ditutup','kayu_dibawa_keluar']) && b.pending_label is list && b.pending_label.size()<=4 && b.pending_label.size()==b.pending.size() && (b.pending_label.size()<1 || b.pending_label[0] is string) && (b.pending_label.size()<2 || b.pending_label[1] is string) && (b.pending_label.size()<3 || b.pending_label[2] is string) && (b.pending_label.size()<4 || b.pending_label[3] is string) && (b.gps==null || (b.gps is map && b.gps.keys().hasOnly(['lat','lng','akurasi_m']) && b.gps.keys().size()==3 && b.gps.lat is number && b.gps.lng is number && b.gps.akurasi_m is number)) && b.id is string && b.id.matches('^lap_cabut_[A-Za-z0-9_-]{1,96}$') && calendar(b.tanggal) && b.kebun in ['K1','K2','K3','K4'] && b.jumlah_pohon is int && b.jumlah_pohon>0 && b.pekerja_nama is string && b.lokasi is string && b.checklist is map && b.checklist.keys().hasOnly(['tali_merah','akar_keluar','lubang_ditutup','kayu_dibawa_keluar']) && b.checklist.keys().size()==4 && b.checklist.tali_merah is bool && b.checklist.akar_keluar is bool && b.checklist.lubang_ditutup is bool && b.checklist.kayu_dibawa_keluar is bool && pendingWork(b);}
 function correctionOwner(o){return grant().role=='staff' && get(/databases/$(database)/documents/laporan/$(o.target)).data.owner_uid==request.auth.uid && get(/databases/$(database)/documents/laporan/$(o.target)).data.submitted_body.schema_version=='3.5';}
 function opShape(o,cid){return o is map && o.keys().hasOnly(['kind','command_id','target','expected_revision','predecessor','reason','body']) && o.keys().size()==7 && o.kind in ['correction','cabut','cabut_log'] && o.command_id==cid && cid.matches('^cmd_[A-Za-z0-9_-]{1,96}$') && o.target is string && o.target.matches('^[A-Za-z0-9_-]{1,100}$') && o.expected_revision is int && o.expected_revision>0 && o.predecessor is string && o.predecessor.size()>0 && o.reason is string && o.reason.size()>0 && o.reason.size()<=500;}
 function staffCabut(b){return b is map && b.keys().hasOnly(['id','kebun','jumlah','tgl','metode','tali','sakit','kondisi','catatan','created_at']) && b.keys().size()==10 && b.id is string && b.id.matches('^cabut_[A-Za-z0-9_-]{1,80}$') && b.kebun in ['K1','K2','K3','K4'] && b.jumlah is int && b.jumlah>0 && calendar(b.tgl) && b.metode in ['cabut','tebang'] && b.tali in ['merah','biru','hijau'] && b.sakit is bool && b.kondisi is string && b.catatan is string && b.created_at is string;}
 function opPayload(o){return o.kind=='correction' ? (correctionOwner(o) && o.body.id==o.target && body(o.body,grant())) : (grant().role=='staff' && o.command_id=='cmd_'+o.body.id && (o.kind=='cabut' ? (o.target=='active' && cabutBody(o.body)) : (o.target=='staff_log' && staffCabut(o.body))));}
 function predecessor(o){return exists(headPath(o)) ? (get(headPath(o)).data.revision==o.expected_revision && get(headPath(o)).data.command_id==o.predecessor) : (o.kind=='correction' && o.expected_revision==1 && o.predecessor==o.target);}
 function opRow(d,cid){return live() && d.keys().hasOnly(['operation','owner_uid','writer_epoch','grant_epoch','revision','committed_at']) && d.keys().size()==6 && d.owner_uid==request.auth.uid && d.writer_epoch==policy().writer_epoch && d.grant_epoch==grant().grant_epoch && d.committed_at==request.time && d.revision==d.operation.expected_revision+1 && opShape(d.operation,cid) && opEnabled(d.operation.kind) && predecessor(d.operation);}
 function nextHead(d){let h=getAfter(headPath(d.operation)).data;return h.revision==d.revision && h.command_id==d.operation.command_id && h.owner_uid==request.auth.uid && h.body==d.operation.body;}
 match /operation_policy/{kind}{allow get:if request.auth!=null;allow list,write:if false;}
 match /operation_events/{cid}{
  allow get:if live() && (grant().role=='staff' || !exists(/databases/$(database)/documents/operation_events/$(cid)) || resource.data.owner_uid==request.auth.uid);
  allow list:if live() && grant().role=='staff';
  allow create:if opRow(request.resource.data,cid) && !exists(/databases/$(database)/documents/operation_receipts/$(cid)) && getAfter(/databases/$(database)/documents/operation_receipts/$(cid)).data==request.resource.data && nextHead(request.resource.data);
  allow update,delete:if false;
 }
 match /operation_receipts/{cid}{
  allow get:if live() && (!exists(/databases/$(database)/documents/operation_receipts/$(cid)) || resource.data.owner_uid==request.auth.uid || grant().role=='staff');
  allow create:if request.auth!=null && !exists(/databases/$(database)/documents/operation_events/$(cid)) && getAfter(/databases/$(database)/documents/operation_events/$(cid)).data==request.resource.data && opPayload(request.resource.data.operation);
  allow list,update,delete:if false;
 }
 function linkedHead(d,kind,target){let event=getAfter(/databases/$(database)/documents/operation_events/$(d.command_id)).data;return !exists(/databases/$(database)/documents/operation_events/$(d.command_id)) && event.operation.kind==kind && event.operation.target==target && event.revision==d.revision && event.owner_uid==request.auth.uid && event.operation.body==d.body && d.owner_uid==request.auth.uid;}
 match /report_heads/{target}{
  allow get:if live() && grant().role=='staff';
  allow list:if live() && grant().role=='staff';
  allow create,update:if request.resource.data.keys().hasOnly(['revision','command_id','owner_uid','body']) && request.resource.data.keys().size()==4 && linkedHead(request.resource.data,'correction',target);
  allow delete:if false;
 }
 match /cabut_state/{target}{
  allow get:if live() && grant().role=='staff' && target in ['active','staff_log'];
  allow update:if target in ['active','staff_log'] && request.resource.data.keys().hasOnly(['revision','command_id','owner_uid','body','total_pohon']) && request.resource.data.keys().size()==5 && request.resource.data.total_pohon==resource.data.total_pohon+(target=='active'?request.resource.data.body.jumlah_pohon:request.resource.data.body.jumlah) && linkedHead(request.resource.data,target=='active'?'cabut':'cabut_log',target);
  allow create,delete,list:if false;
 }
 match /{document=**}{allow read,write:if false;}
}}
